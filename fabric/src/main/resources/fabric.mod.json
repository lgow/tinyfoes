{
  "schemaVersion": 1,
  "id": "${archives_base_name}",
  "name": "${display_name}",
  "version": "${version}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "license": "${license}",
  "icon": "assets/${archives_base_name}/icon.png",
  "contact": {
    "homepage": "${home_page}",
    "issues": "${issue_tracker}"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "github.lgow.tinyfoes.fabric.FabricTinyFoes"
    ],
    "client": [
      "github.lgow.tinyfoes.fabric.FabricClientTinyFoes"
    ]
  },
  "depends": {
    "fabric": "*",
    "minecraft": ">=${minecraft_version}",
    "architectury": ">=${architectury_version}",
    "forgeconfigapiport" : ">=${forgeconfigapiport_version}"
  },
  "mixins": [
    "tinyfoes-common.mixins.json"
  ]
}